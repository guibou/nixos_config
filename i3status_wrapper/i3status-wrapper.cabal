cabal-version:      3.0
name:               i3status-wrapper
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Guillaume Bouchard
maintainer:         guillaum.bouchard@gmail.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable i3status-wrapper
    import:           warnings
    
    -- With -O, hopefully, the string allocation are removed
    -- Wtih -I0, the "idle GC" is not running much. As a result, we save a lot
    -- of CPU cycle, because the current process is able to run for minutes
    -- before triggering a GC.
    ghc-options: -threaded -rtsopts -with-rtsopts=-I0 -O
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    base, bytestring, process, aeson, async, text, vector, containers
    hs-source-dirs:   app
    default-language: GHC2024
