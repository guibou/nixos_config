cabal-version:      3.0
name:               i3status-wrapper
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Guillaume Bouchard
maintainer:         guillaum.bouchard@gmail.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable i3status-wrapper
    import:           warnings
    ghc-options: -threaded -rtsopts
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    base, bytestring, process, aeson, async, text, vector, containers
    hs-source-dirs:   app
    default-language: GHC2024
